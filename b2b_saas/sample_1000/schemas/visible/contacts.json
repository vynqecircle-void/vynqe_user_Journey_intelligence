   "nullable": false,
   "allowed": null,
   "description": ""
  },
  {
   "name": "left_account_at",
   "type": "timestamp",
   "nullable": true,
   "allowed": null,
   "description": ""
  },
  {
   "name": "lead_status",
   "type": "string",
   "nullable": true,
   "allowed": [
    "new",
    "contacted",
    "qualified",
    "converted",
    "lost"
   ],
   "description": "Set for the contact that came in as a lead"
  },
  {
   "name": "lead_source",
   "type": "string",
   "nullable": true,
   "allowed": null,
   "description": ""
  },
  {
   "name": "lead_created_at",
   "type": "timestamp",
   "nullable": true,
   "allowed": null,
   "description": ""
  },
  {
   "name": "lead_converted_at",
   "type": "timestamp",
   "nullable": true,
   "allowed": null,
   "description": ""
  },
  {
   "name": "is_product_user",
   "type": "bool",
   "nullable": false,
   "allowed": null,
   "description": ""
  }
 ]
}